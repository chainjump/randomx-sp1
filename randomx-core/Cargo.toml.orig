[package]
name = "randomx-sp1-core"
version = "0.1.0"
edition = "2024"
description = "Internal RandomX cache, dataset, and VM primitives for randomx-sp1"
license = "GPL-3.0-only"
publish = false

[lib]
name = "randomx_sp1_core"

[dependencies]
blake2b_simd = "1.0.4"
libc = "0.2.183"
log = "0.4.29"
randomx-sp1-argon2 = { path = "../argon2", version = "2.1.0" }
strum = { version = "0.24.0", features = ["derive"] }
